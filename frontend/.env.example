# ---------------------------------------------------------------------------
# Frontend environment — copy to `.env`.
# Only `VITE_`-prefixed variables reach the browser bundle.
# NEVER put a secret here — everything below ships to the client.
# ---------------------------------------------------------------------------

# Base URL the app calls. Leave as a relative path to use the Vite dev proxy
# (no CORS preflight); set an absolute URL when the API is on another origin.
VITE_API_BASE_URL=/api/v1

# Target the dev-server proxy forwards `/api` to.
VITE_PROXY_TARGET=http://localhost:4000

VITE_APP_NAME=School ERP
VITE_ENABLE_DEVTOOLS=true
