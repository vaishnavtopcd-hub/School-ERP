# ---------------------------------------------------------------------------
# Root environment file — consumed by docker-compose.yml
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=school_erp
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=school_erp
POSTGRES_PORT=5432

# --- pgAdmin (optional, `--profile tools`) ---------------------------------
PGADMIN_DEFAULT_EMAIL=admin@school-erp.local
PGADMIN_DEFAULT_PASSWORD=change_me_in_production
PGADMIN_PORT=5050

# --- Backend ---------------------------------------------------------------
BACKEND_PORT=4000
NODE_ENV=development

# Connection string used by Prisma inside the Docker network.
# When running the backend on the host instead, use `localhost` as the host.
DATABASE_URL=postgresql://school_erp:change_me_in_production@postgres:5432/school_erp?schema=public

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:4000/api/v1
