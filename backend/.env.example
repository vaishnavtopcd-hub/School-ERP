# ---------------------------------------------------------------------------
# Backend environment — copy to `.env`.
# Every variable here is validated at boot by src/config/env.validation.ts;
# the process refuses to start if one is missing or malformed.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=1

# --- Database --------------------------------------------------------------
# Host is `postgres` when running via docker-compose, `localhost` on the host.
DATABASE_URL=postgresql://school_erp:change_me_in_production@localhost:5432/school_erp?schema=public

# --- JWT -------------------------------------------------------------------
# Generate strong, DIFFERENT secrets per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Auth policy -----------------------------------------------------------
# Minutes a password-reset link stays valid.
PASSWORD_RESET_TTL_MINUTES=30
# Consecutive failed logins before the account locks.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
# Public URL of the SPA — used to build password-reset links.
WEB_APP_URL=http://localhost:3000

# --- Refresh-token cookie --------------------------------------------------
REFRESH_COOKIE_NAME=school_erp_rt
# MUST be true in production; the app refuses to boot otherwise.
COOKIE_SECURE=false
# Leave unset unless the API and SPA are on different subdomains.
# COOKIE_DOMAIN=.school-erp.example

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins. Use `*` only in local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Pretty-print logs (development). Set false for JSON logs in production.
LOG_PRETTY=true

# --- Swagger ---------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
